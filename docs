<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Detector de Fadiga EAR + MAR</title>
<style>
  :root{--bg:#f4f7f7;--card:#fff;--ink:#12302f;--mut:#5b7170;--teal:#0a7c7a;--ok:#1e9e5a;--warn:#e08a00;--bad:#d62839;--line:#d6e2e1}
  @media (prefers-color-scheme:dark){:root{--bg:#0e1a1a;--card:#162626;--ink:#e6f2f1;--mut:#92aaa8;--teal:#3cc4c0;--line:#294040}}
  *{box-sizing:border-box}
  body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--ink);
       padding:max(12px,env(safe-area-inset-top)) 12px max(12px,env(safe-area-inset-bottom))}
  main{max-width:560px;margin:0 auto;display:flex;flex-direction:column;gap:12px}
  header{display:flex;justify-content:space-between;align-items:flex-start;gap:8px}
  h1{font-size:1.15rem;margin:0;color:var(--teal)}
  header p{margin:2px 0 0;font-size:.8rem;color:var(--mut)}
  .card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:12px}
  button{font:inherit;border:0;border-radius:10px;padding:10px 14px;background:var(--teal);color:#fff;font-weight:600}
  button.ghost{background:transparent;color:var(--teal);border:1px solid var(--teal);padding:4px 10px;font-size:.8rem}
  #stage{position:relative;border-radius:14px;overflow:hidden;background:#000;aspect-ratio:3/4;display:none}
  #stage video,#stage canvas{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scaleX(-1)}
  #banner{position:absolute;left:0;right:0;bottom:0;padding:14px;text-align:center;font-weight:700;color:#fff;background:var(--ok)}
  #banner.alert{background:var(--bad);animation:blink .6s infinite alternate}
  #banner.laugh{background:var(--warn)}
  #banner.wait{background:#3a6ea5}
  @keyframes blink{to{opacity:.6}}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .metric{font-size:.75rem;color:var(--mut)}
  .metric b{display:block;font-size:1.5rem;color:var(--ink);font-variant-numeric:tabular-nums}
  .bar{height:6px;border-radius:3px;background:var(--line);margin-top:4px;position:relative;overflow:hidden}
  .bar i{position:absolute;left:0;top:0;bottom:0;background:var(--teal)}
  .veh{display:flex;align-items:center;gap:10px}
  #road{flex:1;height:34px;border-radius:8px;background:var(--line);position:relative;overflow:hidden}
  #car{position:absolute;top:4px;left:8px;font-size:22px;transition:left .1s linear}
  #vstate{font-weight:700;min-width:96px;text-align:right}
  label{display:block;font-size:.8rem;color:var(--mut);margin-top:8px}
  input[type=range]{width:100%}
  small{color:var(--mut)}
  #msg{font-size:.85rem;color:var(--mut)}
</style>
</head>
<body>
<main>
  <header>
    <div>
      <h1 data-i="title"></h1>
      <p data-i="sub"></p>
    </div>
    <button class="ghost" id="lang">EN</button>
  </header>

  <div class="card">
    <p id="intro" data-i="intro" style="margin:0 0 10px;font-size:.9rem"></p>
    <button id="start" data-i="start"></button>
    <p id="msg"></p>
  </div>

  <div id="stage">
    <video id="v" playsinline muted></video>
    <canvas id="c"></canvas>
    <div id="banner"></div>
  </div>

  <div class="card" id="hud" style="display:none">
    <div class="grid">
      <div class="metric">EAR<b id="ear">–</b><div class="bar"><i id="earBar"></i></div></div>
      <div class="metric">MAR<b id="mar">–</b><div class="bar"><i id="marBar"></i></div></div>
      <div class="metric"><span data-i="closed"></span><b id="tClosed">0.0 s</b></div>
      <div class="metric"><span data-i="det"></span><b id="det">0</b></div>
    </div>
    <div class="veh" style="margin-top:12px">
      <div id="road"><span id="car">🚗</span></div>
      <div id="vstate"></div>
    </div>
    <small data-i="vnote"></small>
  </div>

  <div class="card" id="cfg" style="display:none">
    <b data-i="calib"></b>
    <label><span data-i="earT"></span>: <span id="earTv"></span>
      <input type="range" id="earT" min="0.10" max="0.40" step="0.01" value="0.25"></label>
    <label><span data-i="marT"></span>: <span id="marTv"></span>
      <input type="range" id="marT" min="0.05" max="0.60" step="0.01" value="0.20"></label>
    <label><span data-i="tAlert"></span>: <span id="tAv"></span> s
      <input type="range" id="tA" min="0.5" max="4" step="0.1" value="1.5"></label>
    <small data-i="priv" style="display:block;margin-top:10px"></small>
  </div>
</main>

<script type="module">
import {FaceLandmarker, FilesetResolver} from "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/+esm";

// ---------- textos ----------
const T = {
  pt:{title:"Detector de Fadiga · EAR + MAR",sub:"Prévia do projeto do pôster · SBESC 2026",
    intro:"Feche os olhos por mais de 1,5 s com a boca fechada para disparar o alerta. Sorrir ou bocejar com os olhos fechados não dispara.",
    start:"Iniciar câmera",closed:"Olhos fechados",det:"Detecções",
    vnote:"Simulação do veículo: o alerta equivale ao comando 'p' (parar); 2 s de olhos abertos equivalem ao 'c' (continuar), e o veículo espera mais 2 s antes de andar.",
    calib:"Calibração",earT:"Limiar EAR",marT:"Limiar MAR",tAlert:"Tempo de alerta",
    priv:"A imagem é processada no seu aparelho e não é enviada nem gravada.",
    loading:"Carregando modelo…",noface:"Rosto não detectado",normal:"NORMAL",
    alert:"⚠ FADIGA DETECTADA · veículo pararia aqui",laugh:"Riso/bocejo detectado · não é fadiga",
    verify:"Verificando vigília…",resume:"Vigília confirmada · veículo retomando…",
    run:"RODANDO",stop:"PARADO",wait:"AGUARDANDO",err:"Não foi possível acessar a câmera. Verifique a permissão e se a página está em HTTPS."},
  en:{title:"Drowsiness Detector · EAR + MAR",sub:"Poster project preview · SBESC 2026",
    intro:"Close your eyes for more than 1.5 s with your mouth closed to trigger the alert. Smiling or yawning with closed eyes does not.",
    start:"Start camera",closed:"Eyes closed",det:"Detections",
    vnote:"Vehicle simulation: the alert equals the 'p' (stop) command; 2 s of open eyes equals 'c' (continue), and the vehicle waits another 2 s before moving.",
    calib:"Calibration",earT:"EAR threshold",marT:"MAR threshold",tAlert:"Alert time",
    priv:"Video is processed on your device and is neither uploaded nor recorded.",
    loading:"Loading model…",noface:"No face detected",normal:"NORMAL",
    alert:"⚠ DROWSINESS DETECTED · vehicle would stop here",laugh:"Laugh/yawn detected · not drowsiness",
    verify:"Verifying wakefulness…",resume:"Awake confirmed · vehicle resuming…",
    run:"RUNNING",stop:"STOPPED",wait:"WAITING",err:"Could not access the camera. Check permission and that the page is served over HTTPS."}
};
let lang = navigator.language.startsWith("pt") ? "pt" : "en";
const $ = id => document.getElementById(id);
function applyLang(){
  document.documentElement.lang = lang==="pt"?"pt-BR":"en";
  document.querySelectorAll("[data-i]").forEach(e=>e.textContent=T[lang][e.dataset.i]);
  $("lang").textContent = lang==="pt"?"EN":"PT";
  document.title = T[lang].title;
}
$("lang").onclick = ()=>{lang = lang==="pt"?"en":"pt"; applyLang();};
applyLang();

// ---------- landmarks (iguais ao código original) ----------
const OLHO_ESQ = [385,380,387,373,362,263];
const OLHO_DIR = [160,144,158,153,33,133];
const BOCA     = [82,87,13,14,312,317,78,308];

// Distâncias em pixels reais (x*largura, y*altura), para o EAR/MAR não depender
// da proporção da tela do celular.
const dist = (a,b,W,H)=>Math.hypot((a.x-b.x)*W,(a.y-b.y)*H);
function earOlho(f,p,W,H){
  const q = p.map(i=>f[i]);
  return (dist(q[0],q[1],W,H)+dist(q[2],q[3],W,H))/(2*dist(q[4],q[5],W,H));
}
const calcEAR = (f,W,H)=>(earOlho(f,OLHO_ESQ,W,H)+earOlho(f,OLHO_DIR,W,H))/2;
function calcMAR(f,W,H){
  const b = BOCA.map(i=>f[i]);
  return (dist(b[0],b[1],W,H)+dist(b[2],b[3],W,H)+dist(b[4],b[5],W,H))/(2*dist(b[6],b[7],W,H));
}

// ---------- parâmetros ----------
const cfg = {ear:0.25, mar:0.20, tA:1.5, tVerify:2.0, tVehicle:2.0};
for (const [id,k,out] of [["earT","ear","earTv"],["marT","mar","marTv"],["tA","tA","tAv"]]){
  const el=$(id), o=$(out); o.textContent=(+el.value).toFixed(2).replace(/0$/,"");
  el.oninput=()=>{cfg[k]=+el.value; o.textContent=(+el.value).toFixed(2).replace(/0$/,"");};
}

// ---------- alarme sonoro ----------
let actx=null, lastBeep=0;
function beep(){
  const n=performance.now(); if(n-lastBeep<700) return; lastBeep=n;
  try{
    actx = actx || new (window.AudioContext||window.webkitAudioContext)();
    const o=actx.createOscillator(), g=actx.createGain();
    o.frequency.value=880; g.gain.value=0.15; o.connect(g); g.connect(actx.destination);
    o.start(); o.stop(actx.currentTime+0.25);
  }catch(e){}
}

// ---------- estado ----------
let closedStart=null, alertOn=false, openStart=null, resumeAt=null, detections=0, carX=8;
let vehicle="run"; // run | stop | wait

function step(ear,mar,now){
  let banner="normal", tClosed=0;
  const closedNeutral = ear<cfg.ear && mar<cfg.mar;
  const laugh = ear<cfg.ear && mar>=cfg.mar;

  if(closedNeutral){
    if(closedStart===null) closedStart=now;
    tClosed=(now-closedStart)/1000;
    openStart=null;
    if(!alertOn && tClosed>=cfg.tA){ alertOn=true; detections++; vehicle="stop"; resumeAt=null; }
  } else {
    closedStart=null;
    if(laugh){ openStart=null; if(!alertOn) banner="laugh"; }
    else if(alertOn){                       // olhos abertos: verificação de vigília
      if(openStart===null) openStart=now;
      if((now-openStart)/1000>=cfg.tVerify){
        alertOn=false; openStart=null; vehicle="wait"; resumeAt=now+cfg.tVehicle*1000;
      }
    }
  }
  if(alertOn) banner = openStart!==null ? "verify" : "alert";
  if(vehicle==="wait"){ banner="resume"; if(now>=resumeAt) vehicle="run"; }
  return {banner,tClosed};
}

// ---------- UI ----------
const bannerCls={normal:"",laugh:"laugh",alert:"alert",verify:"wait",resume:"wait"};
const vcol={run:"var(--ok)",stop:"var(--bad)",wait:"var(--warn)"};
function render(ear,mar,r){
  $("ear").textContent=ear.toFixed(3); $("mar").textContent=mar.toFixed(3);
  $("earBar").style.width=Math.min(100,ear/0.5*100)+"%";
  $("marBar").style.width=Math.min(100,mar/0.8*100)+"%";
  $("ear").style.color = ear<cfg.ear?"var(--bad)":"var(--ok)";
  $("tClosed").textContent=r.tClosed.toFixed(1)+" s";
  $("det").textContent=detections;
  const b=$("banner"); b.className=bannerCls[r.banner]; b.textContent=T[lang][r.banner];
  const vs=$("vstate"); vs.textContent=T[lang][vehicle==="run"?"run":vehicle==="stop"?"stop":"wait"]; vs.style.color=vcol[vehicle];
  if(r.banner==="alert") beep();
}
function moveCar(){
  const w=$("road").clientWidth-34;
  if(vehicle==="run"){ carX+=2; if(carX>w) carX=8; }
  $("car").style.left=carX+"px";
}

// ---------- câmera + modelo ----------
let landmarker, video=$("v"), canvas=$("c"), ctx=canvas.getContext("2d"), lastT=-1;

async function start(){
  $("start").disabled=true; $("msg").textContent=T[lang].loading;
  try{
    const stream = await navigator.mediaDevices.getUserMedia({video:{facingMode:"user",width:{ideal:640},height:{ideal:480}},audio:false});
    video.srcObject=stream; await video.play();
    const fs = await FilesetResolver.forVisionTasks("https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/wasm");
    const opts = d=>({baseOptions:{modelAssetPath:"https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task",delegate:d},
                      runningMode:"VIDEO",numFaces:1,minFaceDetectionConfidence:0.5,minTrackingConfidence:0.5});
    try{ landmarker = await FaceLandmarker.createFromOptions(fs,opts("GPU")); }
    catch(e){ landmarker = await FaceLandmarker.createFromOptions(fs,opts("CPU")); }
    $("msg").textContent="";
    $("stage").style.display="block"; $("hud").style.display="block"; $("cfg").style.display="block";
    $("start").style.display="none"; $("intro").style.display="none";
    requestAnimationFrame(loop);
  }catch(e){
    console.error(e); $("msg").textContent=T[lang].err; $("start").disabled=false;
  }
}
$("start").onclick=start;

function loop(){
  requestAnimationFrame(loop);
  if(video.readyState<2 || video.currentTime===lastT) return;
  lastT=video.currentTime;
  const W=video.videoWidth, H=video.videoHeight;
  if(canvas.width!==W){canvas.width=W;canvas.height=H;}
  ctx.clearRect(0,0,W,H);
  const now=performance.now();
  const res=landmarker.detectForVideo(video,now);
  moveCar();
  if(res.faceLandmarks && res.faceLandmarks.length){
    const f=res.faceLandmarks[0];
    ctx.fillStyle="#4aa3ff";
    for(const i of [...OLHO_ESQ,...OLHO_DIR,...BOCA]){
      ctx.beginPath(); ctx.arc(f[i].x*W,f[i].y*H,3,0,6.283); ctx.fill();
    }
    const ear=calcEAR(f,W,H), mar=calcMAR(f,W,H);
    render(ear,mar,step(ear,mar,now));
  } else {
    closedStart=null;
    $("ear").textContent="–"; $("mar").textContent="–"; $("tClosed").textContent="0.0 s";
    const b=$("banner"); b.className=alertOn?"alert":""; b.textContent=alertOn?T[lang].alert:T[lang].noface;
  }
}
</script>
</body>
</html>
